# ---- Python 运行产物 ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 可再生的数据缓存（首次运行自动拉取/生成） ----
# 日线面板 parquet 缓存（约 100 只股票的行情落盘）
data_cache/panel_*.parquet
# 全 A 股名称表（启动时一次拉取落盘）
data_cache/name_map.json
# cninfo 公告缓存（运行时自动拉取）
data_cache/announcements/
# 生成的诊断报告产物（在线 HTML + docx + 图表）
out/

# ---- Evals 运行产物（可复现再生） ----
# 各阶段执行日志
evals/logs/
# Runner 历史运行结果（离线 + E2E）
evals/runner/results/
evals/runner/results_e2e/

# ---- 本机私有内容（不上传） ----
# 个人工作日志与记忆
.workbuddy/
*.log

# ---- 编辑器/系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
